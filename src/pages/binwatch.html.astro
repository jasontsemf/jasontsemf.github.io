---
import { legacyRedirectExpectations } from "../../config/legacy-routes.mjs";

const route = "/binwatch.html";
const redirect = legacyRedirectExpectations.find((expectation) => expectation.route === route);

if (!redirect) {
    throw new Error(`Missing redirect destination for '${route}'.`);
}
---

<head>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FFJCK8QE1P"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }
        gtag("js", new Date());

        gtag("config", "G-FFJCK8QE1P");
    </script>
    <meta http-equiv="refresh" content={`0; URL=${redirect.destination}`} />
</head>