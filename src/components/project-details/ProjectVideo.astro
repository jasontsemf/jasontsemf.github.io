---
interface Props {
    src: string;
    wide?: boolean;
    spacingAfter?: boolean;
}

const { src, wide = false, spacingAfter = false } = Astro.props;
---

<div
    class:list={["animate-box", { "project-video--spacing-after": spacingAfter }]}
    data-animate-effect="fadeInLeft"
    style="position: relative; padding-bottom: 50%;"
>
    <iframe
        class:list={["img-responsive", "img-responsive-shadow", wide ? "jason-youtube-video-wide" : "jason-vimeo-video"]}
        src={src}
        frameborder="0"
        gesture="media"
        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
    />
</div>

<style>
    .project-video--spacing-after {
        margin-bottom: 2.5rem;
    }
</style>
