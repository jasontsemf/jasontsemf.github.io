---
interface Props {
    heading: string;
    imageSrc: string;
    imageAlt?: string;
    reverse?: boolean;
    border?: boolean;
}

const { heading, imageSrc, imageAlt = "", reverse = false, border = true } = Astro.props;
---

<div class:list={["jason-narrow-content", { "jason-border-bottom": border }]}>
    <h3>{heading}</h3>
    <div class="row">
        <div class:list={["flex", reverse ? "flex-col-rev" : "flex-col"]}>
            {
                reverse ? (
                    <>
                        <div class="flex-1 animate-box"><div class="jason-caption"><slot /></div></div>
                        <div class="flex-2 animate-box"><img src={imageSrc} alt={imageAlt} class="img-responsive" data-animate-effect="fadeInLeft" /></div>
                    </>
                ) : (
                    <>
                        <div class="flex-2 animate-box"><img src={imageSrc} alt={imageAlt} class="img-responsive" data-animate-effect="fadeInLeft" /></div>
                        <div class="flex-1 animate-box"><div class="jason-caption"><slot /></div></div>
                    </>
                )
            }
        </div>
    </div>
    <slot name="after" />
</div>
