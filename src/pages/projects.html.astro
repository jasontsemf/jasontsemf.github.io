---
import CanonicalLayout from "../layouts/CanonicalLayout.astro";
---

<CanonicalLayout
    titleSuffix="Portfolio"
    keywords="free html5, free template, free bootstrap, free website template, html5, css3, mobile first, responsive"
    author="FreeHTML5.co"
    activeNav="projects"
    includeOpenSans={true}
    duplicateFontAwesome={true}
>
    <div class="jason-narrow-content-top">
        <h2 class="jason-heading animate-box" data-animate-effect="fadeInLeft">Projects</h2>
        <div class="row animate-box" data-animate-effect="fadeInLeft">
            <div class="col-md-6 work-item">
                <a href="optimice.html">
                    <img src="project/optimice/v2/optimice_thumb_crop.png" alt="optimice" class="img-responsive img-responsive-shadow" />
                    <h3 class="jason-work-title">🖱 OptiMice</h3>
                    <p>PCB Design, BLE, MEN Stack, 3D Print, AI</p>
                </a>
            </div>
            <div class="col-md-6 work-item">
                <a href="bankheist.html">
                    <img src="project/bankheist/thumb_crop.png" alt="bankheist" class="img-responsive img-responsive-shadow" />
                    <h3 class="jason-work-title">💸 BankHeist</h3>
                    <p>IoT, socket.io, express.js, crypto.js, electron.js, serialport.io</p>
                </a>
            </div>
            <div class="col-md-6 work-item">
                <a href="binwatch.html">
                    <img src="project/binwatch/binwatch_thumb.jpg" alt="binwatch" class="img-responsive img-responsive-shadow" />
                    <h3 class="jason-work-title">𝍄 BinWatch</h3>
                    <p>PCB Design, RTC, Atmega328p-au, Low Power</p>
                </a>
            </div>
            <div class="col-md-6 work-item">
                <a href="pbc.html">
                    <img src="project/pbc/pbc_thumb_crop.png" alt="pbc" class="img-responsive img-responsive-shadow" />
                    <h3 class="jason-work-title">💳 PBC (Printed Business Card)</h3>
                    <p>PCB Design, NFC, Antenna</p>
                </a>
            </div>
