---
import SiteHead from "../components/SiteHead.astro";
import SidebarNav from "../components/SidebarNav.astro";
import SiteScripts from "../components/SiteScripts.astro";
import { ensureContentManifestValidated } from "../lib/content-manifest";

type NavKey = "projects" | "about" | "contact";

interface Props {
    titleSuffix: string;
    description?: string;
    keywords: string;
    author: string;
    activeNav?: NavKey;
    darkToggle?: boolean;
    mainClass?: string;
    includeOpenSans?: boolean;
    duplicateFontAwesome?: boolean;
    includeTypingCarousel?: boolean;
    includeGoogleMapScripts?: boolean;
    ogTitle?: string;
    ogImage?: string;
    ogUrl?: string;
    ogSiteName?: string;
    ogDescription?: string;
    twitterTitle?: string;
    twitterImage?: string;
    twitterUrl?: string;
    twitterCard?: string;
    extraStylesheets?: string[];
    extraScripts?: string[];
}

const {
    titleSuffix,
    description,
    keywords,
    author,
    activeNav,
    darkToggle = false,
    mainClass,
    includeOpenSans = true,
    duplicateFontAwesome = false,
    includeTypingCarousel = false,
    includeGoogleMapScripts = false,
    ogTitle,
    ogImage,
    ogUrl,
    ogSiteName,
    ogDescription,
    twitterTitle,
    twitterImage,
    twitterUrl,
    twitterCard,
    extraStylesheets,
    extraScripts
} = Astro.props;

const navToggleClass = `js-jason-nav-toggle jason-nav-toggle${darkToggle ? " dark" : ""}`;

await ensureContentManifestValidated();
---

<!DOCTYPE html>
<html class="no-js">
    <head>
        <SiteHead
            titleSuffix={titleSuffix}
            description={description}
            keywords={keywords}
            author={author}
            includeOpenSans={includeOpenSans}
            duplicateFontAwesome={duplicateFontAwesome}
            ogTitle={ogTitle}
            ogImage={ogImage}
            ogUrl={ogUrl}
            ogSiteName={ogSiteName}
            ogDescription={ogDescription}
            twitterTitle={twitterTitle}
            twitterImage={twitterImage}
            twitterUrl={twitterUrl}
            twitterCard={twitterCard}
            extraStylesheets={extraStylesheets}
        />
    </head>
    <body>
        <div id="jason-page">
            <a href="#" class={navToggleClass}><i></i></a>
            <SidebarNav activeNav={activeNav} />
            <div id="jason-main" class={mainClass}>
                <slot />
            </div>
        </div>
        <SiteScripts
            includeTypingCarousel={includeTypingCarousel}
            includeGoogleMapScripts={includeGoogleMapScripts}
            extraScripts={extraScripts}
        />
    </body>
</html>
