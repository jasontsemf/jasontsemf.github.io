---
interface Props {
    title: string;
    imageSrc: string;
    imageAlt?: string;
}

const { title, imageSrc, imageAlt = "" } = Astro.props;
---

<div class="jason-flex-wrap">
    <div class="col-md-8 col-md-offset-2 animate-box" data-animate-effect="fadeInLeft">
        <div class="jason-card animate-box" data-animate-effect="fadeInLeft">
            <h3>{title}</h3>
            <img src={imageSrc} alt={imageAlt} class="img-responsive" style="margin-bottom: 1em" />
            <slot />
        </div>
    </div>
</div>
