---
import CanonicalLayout from "../layouts/CanonicalLayout.astro";
---

<CanonicalLayout
    titleSuffix="Contact"
    keywords="jason tse, tse man fung, creative technologist, design, tech, hardware, startup, nyu, itp, cityu, scm"
    author="Jason Tse"
    activeNav="contact"
    darkToggle={true}
    includeOpenSans={false}
    includeGoogleMapScripts={true}
>
    <div class="jason-wide-content">
        <div class="map">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d48354.11360680817!2d-74.01043037661354!3d40.75911918917719!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c2588f046ee661%3A0xa0b3281fcecc08c!2sManhattan%2C%20New%20York%2C%20NY!5e0!3m2!1sen!2sus!4v1746811271126!5m2!1sen!2sus"
                frameborder="0"
                style="border:0; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
                allowfullscreen=""
            ></iframe>
        </div>
    </div>
    <div class="jason-more-contact">
        <div class="jason-narrow-content">
            <div class="row">
                <div class="col-md-4">
                    <div class="jason-feature jason-feature-sm" data-animate-effect="fadeInLeft">
                        <div class="jason-text">
                            <p>
                                <span class="jason-icon-contact">📧</span>
                                <br />
                                <a href="mailto: jasontsemf@gmail.com">jasontsemf@gmail.com</a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="jason-feature jason-feature-sm" data-animate-effect="fadeInLeft">
                        <div class="jason-text">
                            <p>
                                <span class="jason-icon-contact">📍</span>
                                <br />New York, NY
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="jason-feature jason-feature-sm" data-animate-effect="fadeInLeft">
                        <div class="jason-text">
                            <p>
                                <span class="jason-icon-contact">📱</span>
                                <br />
                                <a href="tel://">+1 (646) 591-5524</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</CanonicalLayout>
