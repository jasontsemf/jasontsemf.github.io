    <div class="row">
        <div class="col-md-8 col-md-offset-2 animate-box" data-animate-effect="fadeInLeft">
            <div class="animate-box" data-animate-effect="fadeInLeft">
                <h2>Working In Progress</h2>
                <ul>
                    <li>
                        Web platform
                    </li>
                    <ul>
                        <li>
                            E-commerce capability
                        </li>
                        <li>
                            Photogrammetry Reconstruction server
                        </li>
                    </ul>
                    <li>
                        Configuration over Bluetooth via Web Browser
                    </li>
                    <ul>
                        <li>
                            Program functions of buttons, e.g. system and media control
                        </li>
                        <li>
                            Configure speed, scroll wheel direction, etc
                        </li>
                    </ul>

                </ul>
            </div>
        </div>
    </div>
</div> -->
<div class="jason-narrow-content  animate-box" data-animate-effect="fadeInLeft">
    <div class="animate-box" data-animate-effect="fadeInLeft">
        <div class="col-md-8 col-md-offset-2 col-sm-12 col-sm-offset-0">
            <div class="col-md-4 col-sm-4 col-md-offset-4 col-xs-4 text-center">
                <h4>2021 Spring</h4>
            </div>
        </div>
    </div>
    <ProjectDetailNav detailNav={detailNav} />
</div>
</div>
