---
import CanonicalLayout from "../layouts/CanonicalLayout.astro";
---

<CanonicalLayout
    titleSuffix="Electrical Design Engineer"
    keywords="jason tse, tse man fung, creative technologist, design, tech, hardware, startup, nyu, itp, cityu, scm"
    author="Jason Tse"
    darkToggle={true}
    mainClass="js-fullheight"
    includeOpenSans={true}
    duplicateFontAwesome={true}
    includeTypingCarousel={true}
>
    <div class="jason-center-content">
        <h2 class="jason-heading" data-animate-effect="fadeInLeft">
            Hi! I'm Jason. 🔦
            <br />
            I turn the imaginable into the tangible.
        </h2>
        <div class="py-5">
            <div class="output" id="output">
                <h1 class="cursor"></h1>
                <p></p>
            </div>
        </div>
    </div>
</CanonicalLayout>
