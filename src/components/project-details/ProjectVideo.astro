---
interface Props {
    src: string;
    wide?: boolean;
}

const { src, wide = false } = Astro.props;
---

<div class="animate-box" data-animate-effect="fadeInLeft" style="position: relative; padding-bottom: 50%;">
    <iframe
        class:list={["img-responsive", "img-responsive-shadow", wide ? "jason-youtube-video-wide" : "jason-vimeo-video"]}
        src={src}
        frameborder="0"
        gesture="media"
        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
    />
</div>
