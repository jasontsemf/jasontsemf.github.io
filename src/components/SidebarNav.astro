---
type NavKey = "projects" | "about" | "contact";

interface Props {
    activeNav?: NavKey;
}

const { activeNav } = Astro.props;
---

<aside id="jason-aside" role="complementary" class="border js-fullheight">
    <h1 id="jason-logo">
        <a href="index.html"><img class="spin" src="images/j_sq_logo.png" alt="the J Arrow logo" /></a>
    </h1>
    <nav id="jason-main-menu" role="navigation">
        <ul>
            <li class={activeNav === "projects" ? "jason-active" : undefined}>
                <a href="projects.html">Projects</a>
            </li>
            <li class={activeNav === "about" ? "jason-active" : undefined}>
                <a href="about.html">About</a>
            </li>
            <li><a href="download/Jason_Tse_Resume.pdf">Resume</a></li>
            <li class={activeNav === "contact" ? "jason-active" : undefined}>
                <a href="contact.html">Contact</a>
            </li>
            <li><a href="https://jason1996429.wordpress.com/blog/">Blog</a></li>
        </ul>
    </nav>

    <div class="jason-footer">
        <p><small>&copy; 2025 Jason Tse.<br />All Rights Reserved.</small></p>
        <ul>
            <li><a href="https://github.com/jasontsemf"><i class="icon-github"></i></a></li>
            <li><a href="https://www.facebook.com/jason.tse.39"><i class="icon-facebook"></i></a></li>
            <li><a href="https://www.instagram.com/j.creative.lab/"><i class="icon-instagram"></i></a></li>
            <li><a href="https://www.linkedin.com/in/jason-tse-man-fung"><i class="icon-linkedin"></i></a></li>
            <li><a href="https://jasontsemf.medium.com/"><i class="fab fa-medium"></i></a></li>
        </ul>
    </div>
</aside>
